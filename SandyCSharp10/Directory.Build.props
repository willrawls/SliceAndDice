<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Authors>William Rawls</Authors>
    <MetXStringsRoot Condition="'$(MetXStringsRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\xlg\MetX\MetX.Standard.Strings\bin\Debug'))</MetXStringsRoot>
  </PropertyGroup>
</Project>
